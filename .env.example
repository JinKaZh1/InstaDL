# yt-dlp binary resolution: set this if yt-dlp isn't on PATH
# (Docker image already bundles yt-dlp + ffmpeg — no need to set these on Render)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# Optional: Instagram session cookie for age-gated content (v2)
# IG_COOKIE=
RATE_LIMIT_PER_MIN=20
